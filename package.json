{
  "name": "@astralyn/sash",
  "version": "0.7.0",
  "description": "A network toolbox for developers, learning, and research, with a command-line companion and built-in web dashboard.",
  "license": "MIT",
  "author": "ming-kang",
  "type": "module",
  "bin": {
    "sash": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean:build": "node scripts/clean-build.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build:helper": "node scripts/build-helper.mjs",
    "build:dist": "tsdown",
    "build": "npm run clean:build && npm run build:dist && npm run build:ui && npm run build:helper -- --all",
    "build:release": "npm run clean:build && npm run build:dist && npm run build:ui && node --import tsx scripts/build-bootstrap-manifest.mjs --build-helpers",
    "dev": "tsx src/cli.ts",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "typecheck:server": "tsc --noEmit",
    "typecheck:web": "vue-tsc -p web/tsconfig.json --noEmit",
    "lint": "npm run lint:biome && npm run lint:vue",
    "lint:fix": "npm run lint:biome -- --write && npm run lint:vue -- --fix",
    "audit:prod": "node scripts/audit-prod.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke:package": "node scripts/package-smoke.mjs",
    "smoke:ui": "node --import tsx scripts/ui-smoke.mjs",
    "verify:ui": "node --import tsx scripts/ui-verify.mts",
    "verify:ui:core-update": "node --import tsx scripts/core-update-ui-verify.mts",
    "verify:ui:profiles": "node --import tsx scripts/profile-ui-verify.mts",
    "verify:ui:auth": "node --import tsx scripts/web-auth-ui-verify.mts",
    "verify:ui:autostart": "node --import tsx scripts/autostart-ui-verify.mts",
    "prepublishOnly": "node -e \"console.error('Publish with the Publish npm GitHub workflow; it uses the package already accepted by CI.'); process.exit(1)\"",
    "lint:biome": "biome check .",
    "lint:vue": "eslint web/src"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ming-kang/Sash.git"
  },
  "homepage": "https://github.com/ming-kang/Sash#readme",
  "bugs": {
    "url": "https://github.com/ming-kang/Sash/issues"
  },
  "keywords": [
    "cli",
    "sash",
    "network",
    "toolbox",
    "rules",
    "dashboard"
  ],
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "cn-font-split": {
      "koffi": "2.16.3"
    },
    "js-beautify": {
      "editorconfig": "^4.0.1",
      "glob": "^14.0.6"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@remixicon/vue": "^4.9.0",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "@types/sortablejs": "1.15.9",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "cn-font-split": "^7.4.3",
    "codemirror": "^6.0.2",
    "commander": "^15.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "fastify": "^5.12.8",
    "happy-dom": "21.0.4",
    "pinia": "^4.1.0",
    "playwright": "^1.62.1",
    "semver": "^7.8.5",
    "sortablejs": "1.15.7",
    "tsdown": "^0.23.7",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "undici": "^8.12.3",
    "vite": "^8.2.2",
    "vitest": "^5.1.1",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.23",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.7.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "find-my-way": "^9.10.2"
  }
}

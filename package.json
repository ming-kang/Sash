{
  "name": "@astralyn/sash",
  "version": "0.1.0",
  "description": "A lightweight command-line companion for a rule-based network core and its web dashboard. For developers and advanced users.",
  "license": "MIT",
  "author": "ming-kang",
  "type": "module",
  "bin": {
    "sash": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "clean:build": "node scripts/clean-build.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "npm run clean:build && tsc -p tsconfig.build.json && npm run build:ui",
    "dev": "tsx src/cli.ts",
    "typecheck:server": "tsc --noEmit",
    "typecheck:web": "vue-tsc -p web/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "test": "npm run typecheck && node scripts/run-tests.mjs",
    "prepublishOnly": "npm run audit:prod && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ming-kang/Sash.git"
  },
  "homepage": "https://github.com/ming-kang/Sash#readme",
  "bugs": {
    "url": "https://github.com/ming-kang/Sash/issues"
  },
  "keywords": [
    "cli",
    "sash",
    "network",
    "toolbox",
    "rules",
    "dashboard",
    "tun"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "commander": "^13.1.0",
    "cross-spawn": "^7.0.6",
    "undici": "^7.29.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/adm-zip": "^0.5.7",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.4.3",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}

{
  "name": "@astralyn/sash",
  "version": "0.1.2",
  "description": "A network toolbox for developers, learning, and research, with a command-line companion and built-in web dashboard.",
  "license": "MIT",
  "author": "ming-kang",
  "type": "module",
  "bin": {
    "sash": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean:build": "node scripts/clean-build.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "npm run clean:build && tsc -p tsconfig.build.json && npm run build:ui",
    "dev": "tsx src/cli.ts",
    "typecheck:server": "tsc --noEmit",
    "typecheck:web": "vue-tsc -p web/tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "test": "npm run typecheck && node scripts/run-tests.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "prepublishOnly": "npm run audit:prod && npm run lint && npm test && npm run build && npm run smoke:package"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ming-kang/Sash.git"
  },
  "homepage": "https://github.com/ming-kang/Sash#readme",
  "bugs": {
    "url": "https://github.com/ming-kang/Sash/issues"
  },
  "keywords": [
    "cli",
    "sash",
    "network",
    "toolbox",
    "rules",
    "dashboard"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "commander": "^15.0.0",
    "semver": "^7.8.5",
    "undici": "^8.10.2",
    "yaml": "^2.7.0"
  },
  "overrides": {
    "cn-font-split": {
      "koffi": "2.16.3"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@remixicon/vue": "^4.9.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-vue": "^6.0.8",
    "cn-font-split": "^7.4.3",
    "codemirror": "^6.0.2",
    "happy-dom": "20.13.0",
    "playwright": "^1.62.1",
    "sortablejs": "1.15.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
